{
  "expo": {
    "name": "VITRINE",
    "slug": "vitrine",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vitrine",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#f5f3ec",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vitrine.mobile"
    },
    "android": {
      "package": "app.vitrine.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f3ec",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "VITRINE utilise la caméra pour photographier vos vêtements sur cintre."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VITRINE accède à vos photos pour importer un vêtement ou un fond personnalisé."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VITRINE accède à votre photothèque pour enregistrer vos visuels générés.",
          "savePhotosPermission": "VITRINE enregistre vos visuels générés dans votre photothèque."
        }
      ],
      "./plugins/withRevenueCat.js",
      "expo-font",
      "expo-notifications"
    ],
    "icon": "./assets/icon.png"
  }
}
