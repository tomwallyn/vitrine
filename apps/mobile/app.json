{
  "expo": {
    "name": "VITRINE",
    "slug": "vitrine",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vitrine",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#f5f3ec",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vitrine.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.vitrine.mobile",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f3ec",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "VITRINE utilise la caméra pour photographier vos produits (vêtements, objets…).",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VITRINE accède à vos photos pour importer un produit ou un fond personnalisé."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VITRINE accède à votre photothèque pour enregistrer vos visuels générés.",
          "savePhotosPermission": "VITRINE enregistre vos visuels générés dans votre photothèque."
        }
      ],
      "./plugins/withRevenueCat.js",
      "expo-font",
      "expo-notifications",
      "expo-localization"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "2ad22f21-62e4-4851-aef8-068f53077249"
      },
      "router": {}
    },
    "owner": "tomwallyn"
  }
}
