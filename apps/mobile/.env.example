# Clerk — clé publishable (dashboard.clerk.com → votre app → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de l'API Fastify. Sur device réel, remplacer localhost par l'IP LAN
