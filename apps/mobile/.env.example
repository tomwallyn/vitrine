# Clerk — clé publishable (dashboard.clerk.com → votre app → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de l'API Fastify. Sur device réel, remplacer localhost par l'IP LAN
# de la machine qui exécute `pnpm --filter api dev` (ex. http://192.168.1.10:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080

# RevenueCat — clés publiques SDK par plateforme (dashboard RevenueCat →
# Projet → API Keys → Public app-specific API keys). Sans clé, l'écran
# Crédits affiche solde + packs mais désactive l'achat (pas de crash).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
