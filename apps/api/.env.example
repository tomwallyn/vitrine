# Neon Postgres (driver serverless HTTP — pas de pool TCP)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/vitrine?sslmode=require

# fal.ai — moteur IA (FASHN v1.6 / Kling / Nano Banana Pro)
FAL_KEY=

# URL publique de l'API (Cloud Run) — base du webhook fal :
# ${API_PUBLIC_URL}/webhooks/fal?generationId=<id>
API_PUBLIC_URL=https://vitrine-api-xxxx.a.run.app

# Provider du rendu « sur modèle » : fashn (défaut) | kling (swap sans redéploiement)
AI_ONMODEL_PROVIDER=fashn

# Secret optionnel ajouté à l'URL du webhook fal et vérifié à la réception
# (vide = webhook accepté sans vérification)
FAL_WEBHOOK_SECRET=

# Google Cloud Storage — photos sources + rendus (URLs signées PUT v4)
# Créer un bucket + un service account avec le rôle "Storage Object Admin"
# (voir README § Google Cloud Storage). Credentials via ADC :
# GOOGLE_APPLICATION_CREDENTIALS = chemin de la clé JSON du service account
# (ou `gcloud auth application-default login` en local, sans cette variable).
GCS_BUCKET=vitrine-images
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Clerk — vérification des JWT côté API (dashboard.clerk.com → API Keys → Secret key)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=

# RevenueCat — signature du webhook achats
REVENUECAT_WEBHOOK_SECRET=

# Cloud Run injecte PORT ; défaut local
PORT=8080
