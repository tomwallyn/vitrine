{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "serve": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.10.0",
    "@fal-ai/client": "^1.10.1",
    "@google-cloud/storage": "^7.21.0",
    "@neondatabase/serverless": "^1.0.0",
    "@vitrine/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0"
  }
}
