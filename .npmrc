# Projet perso Vitrine : registre public npmjs (la machine pointe par défaut sur l'Artifactory corp Adeo)
registry=https://registry.npmjs.org/

# React Native / Expo work best with a flat node_modules in a pnpm monorepo
node-linker=hoisted

# Ne pas relancer un check d'install avant chaque script (évite l'échec fatal sur build scripts)
verify-deps-before-run=false
