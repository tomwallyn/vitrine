# ── API (apps/api) ────────────────────────────────────────────────
# Neon Postgres (serverless driver, HTTP)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/vitrine?sslmode=require

# fal.ai (moteur IA : FASHN / Kling / Nano Banana Pro)
FAL_KEY=

# Google Cloud Storage (sources + rendus)
GCS_BUCKET=vitrine-images
GCS_PROJECT_ID=

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# RevenueCat (webhook achats)
REVENUECAT_WEBHOOK_SECRET=

# Serveur
PORT=8080

# ── Mobile (apps/mobile) ──────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat — clés publiques SDK (achat désactivé si absentes)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
